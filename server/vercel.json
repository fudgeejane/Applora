{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/@napi-rs/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/pdfjs-dist/standard_fonts/**,server/node_modules/@napi-rs/**,server/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,server/node_modules/pdfjs-dist/standard_fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__api_path=:path*"
    }
  ]
}

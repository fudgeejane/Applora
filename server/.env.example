# Required
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-unique-secret-at-least-32-bytes>
OTP_SECRET=<generate-a-different-secret-at-least-32-bytes>
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional; configure when the corresponding features are enabled
TRUST_PROXY=
EMAIL_USER=
EMAIL_PASS=
GEMINI_API_KEY=
GEMINI_MODEL=
# Legacy flag left for compatibility; resume analysis works when GEMINI_API_KEY is configured.
GEMINI_PAID_SERVICE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOMINATIM_EMAIL=
